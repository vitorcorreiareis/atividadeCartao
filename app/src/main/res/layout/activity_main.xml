<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ============================================= -->
    <!-- CARTÃO VIRTUAL: ViewFlipper alterna entre a
         frente e o verso do cartão (efeito de "virar").

         layout_constraintDimensionRatio="1.586:1" mantém a
         proporção real de um cartão físico (85.6mm x 53.98mm)
         em qualquer largura de tela, em vez de altura fixa. -->
    <!-- ============================================= -->
    <ViewFlipper
        android:id="@+id/cardFlipper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:inAnimation="@anim/in_from_right"
        android:outAnimation="@anim/out_to_left"
        app:layout_constraintDimensionRatio="1.586:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ========== FRENTE DO CARTÃO (índice 0) ========== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#FFC700"
            app:cardCornerRadius="18dp"
            app:cardElevation="16dp">
            <!-- Amarelo mais saturado (#FFC700 no lugar de #FFF200)
                 e elevação maior (16dp) dão mais destaque ao cartão -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvBankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ourocard"
                    android:textColor="#1A1A4D"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imgChip"
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/chip"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBankName" />

                <!-- Fonte monoespaçada dá aparência mais "gravada",
                     e os bullets "••••" substituem os asteriscos "****"
                     do original — mais próximo do padrão real de cartões -->
                <TextView
                    android:id="@+id/tvCardNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="•••• •••• •••• ••••"
                    android:textColor="#1A1A4D"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imgChip" />

                <!-- layout_width="0dp" + marginEnd + maxLines + ellipsize:
                     evita que um nome comprido invada o espaço do logo
                     da bandeira no canto inferior direito -->
                <TextView
                    android:id="@+id/tvCardName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:layout_marginEnd="64dp"
                    android:text="NOME DO TITULAR"
                    android:textColor="#1A1A4D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Logo da bandeira, sem src fixo: setado via código
                     conforme o número digitado (ver MainActivity.kt) -->
                <ImageView
                    android:id="@+id/imgBrandLogo"
                    android:layout_width="60dp"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========== VERSO DO CARTÃO (índice 1) ========== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#FFC700"
            app:cardCornerRadius="18dp"
            app:cardElevation="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/magneticStripe"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="24dp"
                    android:background="#1A1A1A"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Faixa de assinatura: detalhe que o original não tinha,
                     reforça a sensação de verso de cartão real -->
                <View
                    android:id="@+id/signatureStripe"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="20dp"
                    android:background="#F0EDE5"
                    app:layout_constraintTop_toBottomOf="@id/magneticStripe"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.55" />

                <TextView
                    android:id="@+id/lblExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:text="VALIDADE"
                    android:textColor="#1A1A4D"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/signatureStripe" />

                <TextView
                    android:id="@+id/tvCardExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="2dp"
                    android:text="MM/AA"
                    android:textColor="#1A1A4D"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblExpiry" />

                <TextView
                    android:id="@+id/lblCVV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:text="CVV"
                    android:textColor="#1A1A4D"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCardExpiry" />

                <TextView
                    android:id="@+id/tvCardCVV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="2dp"
                    android:text="•••"
                    android:textColor="#1A1A4D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblCVV" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </ViewFlipper>

    <!-- ============================================= -->
    <!-- FORMULÁRIO: dentro de ScrollView para não cortar
         campos em telas menores ou com teclado aberto -->
    <!-- ============================================= -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardFlipper"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Número do Cartão"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginBottom="6dp" />

            <!-- boxCornerRadius arredondado (12dp) em vez de reto:
                 combina com o resto do design (cartão, botão), sem
                 precisar de nenhum drawable extra -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:id="@+id/tilNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:boxStrokeColor="#7C4DFF"
                app:boxStrokeWidthFocused="2dp"
                app:boxBackgroundColor="#1E1E1E"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0000 0000 0000 0000"
                    android:inputType="number"
                    android:maxLength="19"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="15sp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do Titular"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:id="@+id/tilName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:boxStrokeColor="#7C4DFF"
                app:boxStrokeWidthFocused="2dp"
                app:boxBackgroundColor="#1E1E1E"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome Completo"
                    android:inputType="textCapCharacters"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="15sp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Validade"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="CVV"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/tilExpiry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:boxStrokeColor="#7C4DFF"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxBackgroundColor="#1E1E1E"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="MM/AA"
                        android:inputType="number"
                        android:maxLength="5"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:textSize="15sp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/tilCVV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:boxStrokeColor="#7C4DFF"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxBackgroundColor="#1E1E1E"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCVV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="•••"
                        android:inputType="numberPassword"
                        android:maxLength="3"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:textSize="15sp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- MaterialButton (não Button comum) porque suporta
                 app:cornerRadius direto por atributo, sem precisar de
                 nenhum drawable de fundo customizado. A biblioteca
                 Material já está no projeto (é a mesma usada pelo
                 TextInputLayout acima), então isso não exige nenhuma
                 dependência nova nem arquivo novo. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProcess"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:backgroundTint="#7C4DFF"
                android:text="FINALIZAR PAGAMENTO"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:cornerRadius="14dp"
                app:elevation="6dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>