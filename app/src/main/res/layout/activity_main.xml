<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">
    <!-- Fundo escuro (dark mode) da tela inteira -->

    <!-- ============================================= -->
    <!-- CARTÃO VIRTUAL: ViewFlipper alterna entre a
         frente e o verso do cartão (efeito de "virar") -->
    <!-- ============================================= -->
    <ViewFlipper
        android:id="@+id/cardFlipper"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp"
        android:inAnimation="@anim/in_from_right"
        android:outAnimation="@anim/out_to_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <!-- inAnimation/outAnimation: animações customizadas que precisam
             existir em res/anim/. showNext()/showPrevious() no código Kotlin/Java
             disparam a troca entre os dois filhos abaixo -->

        <!-- ========== FRENTE DO CARTÃO (índice 0 do ViewFlipper) ========== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#FFF200"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">
            <!-- Amarelo simulando o cartão físico Ourocard;
                 cardElevation dá a sombra de profundidade -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <!-- Nome do banco, alinhado no canto superior direito -->
                <TextView
                    android:id="@+id/tvBankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ourocard"
                    android:textColor="#003399"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Ícone do chip do cartão, abaixo do nome do banco -->
                <ImageView
                    android:id="@+id/imgChip"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/chip"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBankName" />

                <!-- Número do cartão (será atualizado dinamicamente
                     conforme o usuário digita no campo etNumber) -->
                <TextView
                    android:id="@+id/tvCardNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="**** **** **** ****"
                    android:textColor="#003399"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imgChip" />

                <!-- Nome do titular, fixado no canto inferior esquerdo -->
                <TextView
                    android:id="@+id/tvCardName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="NOME DO TITULAR"
                    android:textColor="#003399"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Logo da bandeira (Visa/Master/Elo etc.), sem src fixo:
                     precisa ser setado via código conforme o número digitado -->
                <ImageView
                    android:id="@+id/imgBrandLogo"
                    android:layout_width="56dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="4dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========== VERSO DO CARTÃO (índice 1 do ViewFlipper) ========== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#FFF200"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Tarja magnética preta, típica do verso de um cartão -->
                <View
                    android:id="@+id/magneticStripe"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:background="#333333"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Rótulo "VALIDADE" -->
                <TextView
                    android:id="@+id/lblExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14dp"
                    android:text="VALIDADE"
                    android:textColor="#003399"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/magneticStripe" />

                <!-- Valor da validade (MM/AA), atualizado a partir de etExpiry -->
                <TextView
                    android:id="@+id/tvCardExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="2dp"
                    android:text="MM/AA"
                    android:textColor="#003399"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblExpiry" />

                <!-- Rótulo "CVV" -->
                <TextView
                    android:id="@+id/lblCVV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text="CVV"
                    android:textColor="#003399"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCardExpiry" />

                <!-- Valor do CVV, atualizado a partir de etCVV -->
                <TextView
                    android:id="@+id/tvCardCVV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="2dp"
                    android:text="***"
                    android:textColor="#003399"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblCVV" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </ViewFlipper>

    <!-- ============================================= -->
    <!-- FORMULÁRIO: dentro de ScrollView para não cortar
         campos em telas menores ou com teclado aberto -->
    <!-- ============================================= -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardFlipper"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- Preenche todo o espaço restante abaixo do cartão (0dp + constraints) -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Label acima do campo "Número do Cartão" -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Número do Cartão"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Campo de número do cartão: numérico, limitado a 19 caracteres
                 (16 dígitos + 3 espaços no formato 0000 0000 0000 0000) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:id="@+id/tilNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#7C4DFF"
                app:boxBackgroundColor="#1E1E1E"
                app:hintEnabled="false">
                <!-- hintEnabled=false porque já existe um TextView de label acima;
                     o "hint" do EditText abaixo funciona só como placeholder -->

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0000 0000 0000 0000"
                    android:inputType="number"
                    android:maxLength="19"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Label acima do campo "Nome do Titular" -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do Titular"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Campo de nome: textCapCharacters força exibição em
                 CAIXA ALTA enquanto digita (padrão visual de cartão físico) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:id="@+id/tilName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#7C4DFF"
                app:boxBackgroundColor="#1E1E1E"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome Completo"
                    android:inputType="textCapCharacters"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Linha com os dois labels "Validade" e "CVV" lado a lado,
                 cada um ocupando 50% da largura (weightSum="2") -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Validade"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="CVV"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Linha com os campos de Validade e CVV, também 50/50 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Campo Validade: numérico, limitado a 5 chars (MM/AA) -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/tilExpiry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:boxStrokeColor="#7C4DFF"
                    app:boxBackgroundColor="#1E1E1E"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="MM/AA"
                        android:inputType="number"
                        android:maxLength="5"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo CVV: numberPassword esconde os dígitos digitados
                     (mostra pontos), limitado a 3 caracteres -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/tilCVV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:boxStrokeColor="#7C4DFF"
                    app:boxBackgroundColor="#1E1E1E"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCVV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="•••"
                        android:inputType="numberPassword"
                        android:maxLength="3"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Botão final: dispara a lógica de validação/processamento
                 do pagamento no código Kotlin/Java (setOnClickListener) -->
            <Button
                android:id="@+id/btnProcess"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#7C4DFF"
                android:text="FINALIZAR PAGAMENTO"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>